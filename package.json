{
  "name": "webclip",
  "version": "1.1.0",
  "private": true,
  "description": "Capture the rendered active webpage to a screenshot-based PDF (Chrome MV3 extension).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Andrew P. Michelis (KnackMentor)",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "check": "npm run typecheck && npm run test && npm run build",
    "verify:pdf": "node scripts/verify-pdf.mjs",
    "harness": "node scripts/harness.mjs",
    "release:check": "bash scripts/release-check.sh",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^26.2.0",
    "esbuild": "^0.23.0",
    "playwright": "^1.62.1",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
